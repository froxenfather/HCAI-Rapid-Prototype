# Copy this file to .env (in this directory or the repo root) and fill in
# your own values. Never commit the real .env file.

# Required for real Gemini generation. Leave blank to run in fake mode or to
# get a controlled 503 from /api/v1/generate-post.
GEMINI_API_KEY=

# Model name is configurable so it never needs to be hard-coded in the app.
GEMINI_MODEL=gemini-3.5-flash-lite

# Generation temperature: enough freedom for natural prose, low enough to
# avoid improvised facts (plan section 23).
GEMINI_TEMPERATURE=0.4

# "gemini" (default) calls the real API. "fake" always uses the deterministic
# offline stand-in, useful for frontend development without an API key.
AI_PROVIDER=gemini

APP_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
